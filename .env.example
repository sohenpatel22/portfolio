# ---- AI assistant ("Ask about Sohen") ----
# Server-side only. Never prefix these with NEXT_PUBLIC_. Copy to .env.local for local development.
# The assistant is OFF until LLM_API_KEY is set, and it also needs Redis in production (see below).

LLM_API_KEY=

# Pick ONE provider block. Both use the OpenAI-compatible chat API.
#
# DeepSeek (thinking MUST be disabled, otherwise hidden reasoning tokens are billed as output):
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
#
# OpenAI gpt-6-luna on FLEX processing (recommended: about half the price, with a standard-rate fallback).
# Reasoning defaults to medium, so set it to none; this model needs max_completion_tokens.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6-luna
# LLM_TOKEN_PARAM=max_completion_tokens
# LLM_OMIT_TEMPERATURE=true
# LLM_EXTRA_BODY={"reasoning_effort":"none"}
# LLM_SERVICE_TIER=flex

# Flex is cheaper but slower and sometimes unavailable (429). With LLM_SERVICE_TIER=flex the app tries flex
# first and, if it is slow or unavailable, retries once on standard processing (the "fallback"), which costs
# about twice as much and therefore has its own strict budgets.
# LLM_FLEX_FALLBACK=true              set false to never fall back (visitors then see an error when flex is down)
# LLM_FLEX_FIRST_BYTE_MS=8000         how long to wait for flex before falling back
# CHAT_FALLBACK_IP_DAILY_LIMIT=5      fallback answers per visitor per day
# CHAT_FALLBACK_DAILY_LIMIT=30        fallback answers per day across everyone

# Budgets (shared across serverless instances through Redis).
# Defaults: standard processing 5 per visitor per hour and per day, 30 per day overall.
#           flex (LLM_SERVICE_TIER=flex) 10 per visitor per hour and per day, 100 per day overall.
# CHAT_IP_HOURLY_LIMIT=
# CHAT_IP_DAILY_LIMIT=
# CHAT_DAILY_LIMIT=
CHAT_MAX_OUTPUT_TOKENS=300

# Kill switch: set to false to turn the AI text box off instantly (preset questions keep working)
CHAT_ENABLED=true

# Redis for the counters (Upstash). Added automatically by the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: salt for hashing visitor IPs in rate-limit keys and for the prompt-leak marker
CHAT_HASH_SALT=

# Local testing only. Never set these in production.
# CHAT_ALLOW_MEMORY_STORE=true   lets the limiter use process memory when Redis is not configured
# CHAT_EVAL_DRY_RUN=true         makes /api/chat stop after the gate and limits, for eval/chat
