# ---- AI assistant ("Ask about Sohen") ----
# Server-side only. Never prefix these with NEXT_PUBLIC_. Copy to .env.local for local development.

# Any OpenAI-compatible chat API. The assistant is OFF until LLM_API_KEY is set.
LLM_API_KEY=
# DeepSeek (default):   https://api.deepseek.com            model: deepseek-chat
# OpenAI:               https://api.openai.com/v1           model: gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Rate limits (shared across serverless instances through Redis)
CHAT_IP_HOURLY_LIMIT=10
CHAT_IP_DAILY_LIMIT=25
CHAT_DAILY_LIMIT=300
CHAT_MAX_OUTPUT_TOKENS=300

# Kill switch: set to false to turn the AI text box off instantly (preset questions keep working)
CHAT_ENABLED=true

# Redis for the counters (Upstash). Added automatically by the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: salt for hashing visitor IPs in rate-limit keys
CHAT_HASH_SALT=

# Local testing only: lets the limiter use process memory when Redis is not configured.
# Never set this in production. Production fails closed without Redis.
# CHAT_ALLOW_MEMORY_STORE=true
